# Binance Web3 API credentials. Never expose these in the browser.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# Quote + simulation gate. Amount is in the from-token's smallest unit.
# Use public addresses only here; the gate never needs a private key.
AFTERBELL_WALLET_ADDRESS=
AFTERBELL_FROM_TOKEN_ADDRESS=
AFTERBELL_TO_TOKEN_ADDRESS=
AFTERBELL_QUOTE_AMOUNT=
AFTERBELL_SLIPPAGE_PERCENT=0.5

# Optional BSC endpoints used by later mainnet deployment and verification work.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_CHAIN_ID=56
BSC_DEPLOYER_PRIVATE_KEY=
AFTERBELL_SIGNER_ADDRESS=
# Deliberately blank. Set to BSC_MAINNET only for a reviewed production deployment.
DEPLOY_CONFIRM=

# Credential signer. Do not commit a funded key.
AFTERBELL_SIGNER_PRIVATE_KEY=
CONTINUITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Runtime
PORT=4173
HOST=127.0.0.1
# Required before binding the API to a non-loopback host. Protects mutable and signing endpoints.
AFTERBELL_API_TOKEN=
AFTERBELL_TASK_JOURNAL=.runtime/watchtower.jsonl
